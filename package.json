{
  "name": "transcript-youtube-videos-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "rag:model:fetch": "node scripts/fetch-rag-model.mjs",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests test/unit",
    "test:integration": "vitest run --passWithNoTests test/integration",
    "test:rag:offline": "vitest run test/unit/rag-chunker.test.ts test/integration/local-e5-encoder.test.ts test/integration/lancedb-rag-index.test.ts test/integration/rag-search-service.test.ts test/integration/rag-ingestion-worker.test.ts test/evaluation",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@fastify/swagger": "9.8.1",
    "@hallelx/youtube-transcript": "0.2.0",
    "@huggingface/transformers": "4.2.0",
    "@lancedb/lancedb": "0.37.1",
    "apache-arrow": "18.1.0",
    "fastify": "5.12.1",
    "pdfkit": "0.20.1",
    "prom-client": "15.1.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@readme/openapi-parser": "8.0.0",
    "@types/node": "22.18.6",
    "@types/pdfkit": "0.17.6",
    "railway": "3.11.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "yaml": "2.9.0"
  },
  "overrides": {
    "@lancedb/lancedb": {
      "@huggingface/transformers": "4.2.0"
    },
    "adm-zip": "0.6.0",
    "sharp": "0.35.4"
  }
}
