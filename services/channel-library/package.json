{
  "name": "channel-transcript-library",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:api": "node --env-file-if-exists=.env --import tsx --watch api/server.ts",
    "dev:web": "vite --host 127.0.0.1",
    "start": "node --env-file-if-exists=.env dist/api/server.js",
    "build": "tsc -p tsconfig.build.json && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check api web test browser *.ts *.json",
    "format": "biome check --write api web test browser *.ts *.json",
    "test": "vitest run",
    "test:browser": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run test:browser"
  },
  "dependencies": {
    "@fastify/static": "10.1.5",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@playwright/test": "1.63.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "4.1.11"
  }
}
